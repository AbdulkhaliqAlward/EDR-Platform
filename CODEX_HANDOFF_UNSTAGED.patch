-		return
-	}
-	defer tok.Close()
-
-	if u, err := tok.GetTokenUser(); err == nil {
-		sid = u.User.Sid.String()
-		if acct, dom, _, err := u.User.Sid.LookupAccount(""); err == nil {
-			user = dom + `\` + acct
-		}
-	}
-	elevated = tok.IsElevated()
-
-	var isz uint32
