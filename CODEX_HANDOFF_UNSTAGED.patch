-func getPrivileges(pid uint32) (sid, user string, elevated bool, integrity string) {
-	if pid == 0 || pid == 4 {
-		return
-	}
-	h, err := windows.OpenProcess(0x1000, false, pid)
-	if err != nil {
-		return
-	}
-	defer windows.CloseHandle(h)
-
-	var tok windows.Token
