+		ch = make(chan struct{}, 1)
+		e.agentLocks[agentID] = ch
+	}
+	e.agentLocksMu.Unlock()
+	select {
+	case ch <- struct{}{}:
+		return func() { <-ch }, true
+	case <-e.baseCtx.Done():
+		return nil, false
+	}
+}
