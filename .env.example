# =============================================================================
# MITRAS — environment template
#
# Copy this file to `.env` (which is gitignored) and fill in REAL values.
# `docker compose` reads `.env` automatically; `go run`/`npm run` loaders
# read it via your shell or via tools like `direnv` / `dotenv-cli`.
#
# NEVER commit a populated `.env`. NEVER paste real secrets into examples.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL — used by all back-end services
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=edr
POSTGRES_DB=edr
# Generate a strong value: `openssl rand -base64 32`
POSTGRES_PASSWORD=change-me-please
POSTGRES_PORT=31432
DATABASE_PASSWORD=${POSTGRES_PASSWORD}

# ─────────────────────────────────────────────────────────────────────────────
# Key Encryption (encrypted-at-rest for ca.key, server.key, jwt_private.pem)
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED in production. The passphrase is fed through Argon2id to derive
# an AES-256 Key Encryption Key (KEK). On first boot plaintext key files are
# encrypted to .enc files and the originals are deleted. On subsequent boots
# the .enc files are decrypted into memory — plaintext keys never touch disk.
# Generate a strong value: `openssl rand -base64 32`
MASTER_KEY_PASSPHRASE=change-me-to-a-strong-random-passphrase

# ─────────────────────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PORT=31379
# Empty = no auth (only acceptable on a private network). Set a value in prod.
REDIS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────────────────────────────────────────
ZOOKEEPER_PORT=31181
KAFKA_EXTERNAL_PORT=31292

# ─────────────────────────────────────────────────────────────────────────────
# Initial admin account (used only the first time the DB is seeded)
# ─────────────────────────────────────────────────────────────────────────────
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
# If left blank the server generates a random password and prints it ONCE
# at startup. Capture it from the logs and change it on first login.
INITIAL_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# JWT (Sigma engine reads JWT_SECRET; Connection Manager uses RSA key files)
# ─────────────────────────────────────────────────────────────────────────────
# `openssl rand -base64 64`
JWT_SECRET=change-me-please
# Connection Manager JWT TTL (configure in config/config.yaml → jwt.access_ttl / jwt.refresh_ttl):
#   JWT_ACCESS_TTL=1h       # Access token: short-lived (default 1 hour)
#   JWT_REFRESH_TTL=336h    # Refresh token: 14 days — fixed from login, NOT sliding

# ─────────────────────────────────────────────────────────────────────────────
# SMTP — outbound email for MFA verification codes
# ─────────────────────────────────────────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_START_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="MITRAS <no-reply@example.com>"

# ────────────────────────────────────────────────────────────────────────────
# Login MFA (two-factor via email OTP)
# ────────────────────────────────────────────────────────────────────────────
# false (default): login never asks for a second factor.
# true: users with MFA turned on must enter an emailed code. Requires SMTP;
#       while email is unavailable those users are refused login (fail-safe).
MFA_ENABLED=false

# ────────────────────────────────────────────────────────────────────────────
# Out-of-band approval for manual endpoint commands
# ────────────────────────────────────────────────────────────────────────────
# COMMAND_APPROVAL_ENABLED=false (default): no OTP is asked for commands.
# When true AND SMTP_ENABLED=true AND EC2_EMAIL_VERIFY is set, every command
# issued from the dashboard (isolate, kill_process, quarantine_file, run_cmd,
# script runs, script-library changes, …) is paused until a 6-digit OTP sent
# to EC2_EMAIL_VERIFY is entered. Automated paths (Sigma → response engine)
# are NOT affected.
COMMAND_APPROVAL_ENABLED=false
EC2_EMAIL_VERIFY=

# ────────────────────────────────────────────────────────────────────────────
# Automated response (server-side response engine)
# ────────────────────────────────────────────────────────────────────────────
# true (default): new Sigma alerts are matched against enabled automation
#   rules; rules marked auto_execute run their playbook on the alert's
#   endpoint (per-endpoint cooldown, at most once per alert).
# false: kill switch — nothing runs automatically; manual runs still work.
AUTOMATION_AUTO_EXECUTE=true
